# Proxy único da VPS: um bloco por app. O Caddy tira o certificado HTTPS de cada subdomínio sozinho.
# Para um app novo, coloque o backend dele na rede "web" e adicione um bloco aqui.

pots.{$BASE_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy pots-api:3000
	}

	# front estático do Pots (SPA): rota desconhecida cai no index.html
	handle {
		root * /srv/pots
		try_files {path} /index.html
		file_server
	}
}

