# Domínio público (o Google não aceita login em IP). Ex.: pots.seudominio.com.br
DOMAIN=pots.exemplo.com.br
APP_URL=https://pots.exemplo.com.br

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud Console > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: https://SEU_DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backup contínuo do SQLite (Litestream) num bucket S3 compatível.
# Cloudflare R2: endpoint https://<account_id>.r2.cloudflarestorage.com, region auto
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Só para rodar localmente (pnpm dev)
PORT=3000
DATABASE_PATH=./data/pots.db
